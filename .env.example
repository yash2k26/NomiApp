# Copy to .env and fill in real values. Anything prefixed EXPO_PUBLIC_ is bundled
# into the client at build time — do NOT use this file for true secrets.

# PostHog (analytics + lightweight error capture)
# Project key from https://us.posthog.com → Settings → Project. Free tier is fine to start.
EXPO_PUBLIC_POSTHOG_KEY=
# Optional: defaults to https://us.i.posthog.com if unset. Set to https://eu.i.posthog.com for EU region.
EXPO_PUBLIC_POSTHOG_HOST=

# Helius RPC (already in use by src/lib/solanaClient.ts)
EXPO_PUBLIC_HELIUS_API_KEY=

# Diary LLM proxy (Cloudflare Worker URL — see workers/diary/README.md to deploy)
# If unset, diary falls back to the local template generator. Safe to leave empty in dev.
EXPO_PUBLIC_DIARY_API_URL=

# Push worker URL (Cloudflare Worker — see workers/push/README.md to deploy).
# If unset, only local notifications work; server-side return pushes are disabled.
EXPO_PUBLIC_PUSH_API_URL=

# State backup worker URL (Cloudflare Worker — see workers/state/README.md).
# Backs up XP/streak/coins/freezes/etc. so users don't lose progress on
# reinstall or wallet reconnect. If unset, app works but progress is local
# only (the bug we built this to fix is back).
EXPO_PUBLIC_STATE_API_URL=

# Shared secret guarding the state/push/diary workers. Generate with:
#   node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"base64url\"))"
# Then set the SAME value on each worker via: wrangler secret put APP_TOKEN
EXPO_PUBLIC_STATE_API_TOKEN=
