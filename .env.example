# Copy to .env and fill in real values. Anything prefixed EXPO_PUBLIC_ is bundled
# into the client at build time — do NOT use this file for true secrets.

# PostHog (analytics + lightweight error capture)
# Project key from https://us.posthog.com → Settings → Project. Free tier is fine to start.
EXPO_PUBLIC_POSTHOG_KEY=
# Optional: defaults to https://us.i.posthog.com if unset. Set to https://eu.i.posthog.com for EU region.
EXPO_PUBLIC_POSTHOG_HOST=

# Helius RPC (already in use by src/lib/solanaClient.ts)
EXPO_PUBLIC_HELIUS_API_KEY=

# Solana network — mainnet (default), devnet, or testnet. Affects both the
# RPC endpoints used and the SOLANA_NETWORK constant the rest of the app reads.
EXPO_PUBLIC_SOLANA_NETWORK=mainnet

# Optional: address of the Metaplex Collection NFT this app's mints belong to.
# Leave empty until a collection is created (see docs); when set, every new
# mint metadata will declare collection={ key: <this>, verified: false } so
# wallets can group them and a follow-up verify_collection ix from the
# collection's update authority can verify each mint.
#
# v1.3 follow-up (Audit Finding 3.1): until verifyCollection is called by the
# collection's update authority, wallets show "Collection: Unverified" on each
# new mint. Two options to verify:
#   (a) Manual: after a mint, run a one-off script signed by the collection
#       update-authority keypair that calls verifyCollectionV1 (see Metaplex
#       @metaplex-foundation/mpl-token-metadata). Batch many mints in a single
#       tx for efficiency.
#   (b) Automated: store the update-authority private key as a Cloudflare
#       Worker secret (separate worker, NOT the existing nomi-state). On
#       each /purchases/confirm with kind=mint, the worker calls
#       verifyCollectionV1 for that mint. Add COLLECTION_UPDATE_AUTHORITY
#       secret via `wrangler secret put`. SECURITY: this is a hot key — any
#       compromise lets attackers verify fake collection mints.
# Either approach is post-launch; the unverified badge is cosmetic only.
EXPO_PUBLIC_NFT_COLLECTION_MINT=

# Optional: override the NFT off-chain metadata URI (json). Defaults to the
# GitHub-hosted file. Recommended in production to point at an Arweave or
# IPFS gateway so the metadata is decentralized and not dependent on github.com
# availability — e.g. https://arweave.net/<txid> or https://ipfs.io/ipfs/<cid>.
#
# v1.3 follow-up (Audit Finding 3.2): GitHub Raw is a single point of failure.
# To migrate:
#   1. Upload assets/nft-metadata.json + the image it references to Arweave:
#      `npx arkb deploy assets/nft-metadata.json --wallet path/to/arweave-key.json`
#   2. Note the returned tx id, set EXPO_PUBLIC_NFT_METADATA_URI=https://arweave.net/<txid>
#   3. Rebuild the APK. Future mints will reference Arweave. Existing on-chain
#      mints keep their original GitHub URI (Solana metadata is immutable).
EXPO_PUBLIC_NFT_METADATA_URI=

# Diary LLM proxy (Cloudflare Worker URL — see workers/diary/README.md to deploy)
# If unset, diary falls back to the local template generator. Safe to leave empty in dev.
EXPO_PUBLIC_DIARY_API_URL=

# Push worker URL (Cloudflare Worker — see workers/push/README.md to deploy).
# If unset, only local notifications work; server-side return pushes are disabled.
EXPO_PUBLIC_PUSH_API_URL=

# State backup worker URL (Cloudflare Worker — see workers/state/README.md).
# Backs up XP/streak/coins/freezes/etc. so users don't lose progress on
# reinstall or wallet reconnect. If unset, app works but progress is local
# only (the bug we built this to fix is back).
EXPO_PUBLIC_STATE_API_URL=

# Shared secret guarding the state/push/diary workers. Generate with:
#   node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"base64url\"))"
# Then set the SAME value on each worker via: wrangler secret put APP_TOKEN
EXPO_PUBLIC_STATE_API_TOKEN=
